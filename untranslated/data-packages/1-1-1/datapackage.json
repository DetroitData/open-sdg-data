{
  "resources": [
    {
      "path": "data.csv",
      "name": "data",
      "profile": "tabular-data-resource",
      "scheme": "file",
      "format": "csv",
      "hashing": "md5",
      "encoding": "utf-8",
      "schema": {
        "fields": [
          {
            "name": "Year",
            "type": "integer"
          },
          {
            "name": "Age",
            "type": "string",
            "constraints": {
              "enum": [
                "Under 18",
                "18 to 64",
                "65 years and over",
                ""
              ]
            }
          },
          {
            "name": "Sex",
            "type": "string",
            "constraints": {
              "enum": [
                "Male",
                "Female",
                ""
              ]
            }
          },
          {
            "name": "Race",
            "type": "string",
            "constraints": {
              "enum": [
                "White",
                "Black or African American",
                "American Indian and Alaska Native",
                "Asian",
                "Native Hawaiian and Other Pacific Islander",
                "Some other race",
                "Two or more races",
                "Hispanic or Latino orgin (of any race)",
                "White alone, not Hispanic or Latino",
                "Hispanci or Latino orgin (of any race)",
                ""
              ]
            }
          },
          {
            "name": "Education",
            "type": "string",
            "constraints": {
              "enum": [
                "Less than high school graduate",
                "High school graduate (includes equivalency)",
                "Some college or associates's degree",
                "Bachelor's degree or higher",
                ""
              ]
            }
          },
          {
            "name": "Employment Status",
            "type": "string",
            "constraints": {
              "enum": [
                "Full-time, year round",
                "Less than full time, year round",
                "Did not work",
                ""
              ]
            }
          },
          {
            "name": "Geographic Location",
            "type": "string",
            "constraints": {
              "enum": [
                "Urban",
                "urban",
                ""
              ]
            }
          },
          {
            "name": "Units",
            "type": "string",
            "constraints": {
              "enum": [
                "Percent by Age",
                "Percent by Sex",
                "Percent by Race",
                "Percent by Education",
                "Percent by Employment Status",
                ""
              ]
            }
          },
          {
            "name": "Value",
            "type": "number"
          }
        ]
      }
    }
  ],
  "profile": "data-package",
  "name": "1-1-1",
  "title": "Proportion of the population living below the international poverty line by sex, age, employment status and geographic location (urban/rural)"
}